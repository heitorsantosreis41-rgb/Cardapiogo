# ============================================================
# CardápioGo — exemplo de variáveis de ambiente
# Copie para .env (ou preencha no painel do seu host) e ajuste.
# ============================================================

# Porta do servidor
PORT=3000

# URL PÚBLICA do app (usada nos QR codes, links de cardápio e reset).
# Deve ser a URL pública que você obterá no deploy.
# Ex.: https://cardapiogo.onrender.com
CG_BASE_URL=http://localhost:3000

# Pasta do banco JSON (opcional). Em produção, aponte para um volume persistente.
CG_DATA_DIR=./data

# ---- AbacatePay (pagamentos PIX) ----
# Chave de API (painel AbacatePay -> API Keys). NUNCA vai para o frontend.
ABACATEPAY_API_KEY=

# O MESMO secret que você definiu ao criar o webhook no dashboard AbacatePay.
ABACATEPAY_WEBHOOK_SECRET=

# Opcional: chave pública da AbacatePay (já embutida como padrão no código).
# ABACATEPAY_PUBLIC_KEY=

# SOMENTE teste/demo: 1 libera upgrade direto a planos pagos sem PIX.
# Em produção NÃO defina esta variável.
# CG_ALLOW_INSTANT_UPGRADE=1